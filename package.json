{
  "name": "mimiterm",
  "version": "0.5.0",
  "description": "MimiTerm — a Claude Code-native terminal with tab groups, backed by tmux",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "electron-packager . MimiTerm --overwrite --no-asar --icon=assets/icon.icns --extend-info=build/extend-info.plist --out=dist",
    "install-app": "rsync -a --delete dist/MimiTerm-darwin-arm64/MimiTerm.app/ /Applications/MimiTerm.app/",
    "deploy": "npm run package && npm run install-app"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.1.1",
    "@electron/rebuild": "^3.6.0",
    "electron": "^33.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  }
}
